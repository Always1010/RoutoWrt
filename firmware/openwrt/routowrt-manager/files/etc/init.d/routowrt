#!/bin/sh /etc/rc.common
START=95
STOP=10
USE_PROCD=1

start_service() {
 umask 077
 mkdir -p /tmp/routowrt
 [ -s /tmp/routowrt/runtime.json ] || /usr/libexec/routowrt-boot || return 0
 /usr/libexec/routowrt-core-prepare || return 1
 /usr/bin/sing-box check -c /tmp/routowrt/runtime.json >/dev/null 2>&1 || return 1
 procd_open_instance
 procd_set_param command /usr/libexec/routowrt-core-run
 procd_set_param respawn 3600 5 3
 procd_set_param limits core="0"
 procd_set_param stdout 0
 procd_set_param stderr 0
 procd_close_instance
}

stop_service() {
 # rc.common continues into procd_kill after a mere return 1. Abort this process
 # when the forwarding transition fails so the live core remains available.
 [ -x /usr/libexec/routowrt-forwarding ] || exit 1
 if [ -f /tmp/routowrt/restarting.json ]; then
  /usr/libexec/routowrt-forwarding guard || exit 1
 else
  /usr/libexec/routowrt-forwarding stop || exit 1
 fi
}

service_started() {
 # rc.common invokes this before the child is necessarily ready. The one-shot
 # confirmer only activates a boot recovery after the core API confirms it.
 /usr/libexec/routowrt-post-start >/dev/null 2>&1 &
}
