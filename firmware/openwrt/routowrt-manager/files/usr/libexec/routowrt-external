#!/usr/bin/ucode
'use strict';
import { call } from 'routowrt.store';
let method={reconcile:'external_reconcile',disable:'external_disable',shutdown:'external_shutdown',status:'external_status'}[ARGV[0]];
if(!method){warn('Usage: routowrt-external {reconcile|disable|shutdown|status}\n');exit(2);}
let result=call(method,{},true);
print(sprintf('%J\n',result));exit(result.ok?0:1);
