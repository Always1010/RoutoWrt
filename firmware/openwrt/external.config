# Optional RoutoWrt adapter only; combine with a matching existing target/SDK.
CONFIG_PACKAGE_routowrt-external-manager=m
CONFIG_PACKAGE_routowrt-external-forwarding=m
CONFIG_PACKAGE_luci-app-routowrt-external=m
# CONFIG_PACKAGE_routowrt-core is not set
# CONFIG_PACKAGE_routowrt-manager is not set
# CONFIG_PACKAGE_routowrt-forwarding is not set
# CONFIG_PACKAGE_luci-app-routowrt is not set
# Keep the target's BusyBox defaults/customization. The build preflight checks
# effective NSLOOKUP and FEATURE_NSLOOKUP_BIG; verify -port= on the target too.
